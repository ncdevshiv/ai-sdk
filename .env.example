# AI SDK gateway credentials — copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real keys.

# OpenAI-compatible gateway (project default)
AI_SDK_GATEWAY_BASE_URL=https://opencode.ai/zen/go/v1
AI_SDK_GATEWAY_API_KEY=sk-your-key-here

# Models used by the live integration tests
AI_SDK_PRIMARY_MODEL=deepseek-v4-flash
AI_SDK_VISION_MODEL=mimo-v2.5

# Standard provider keys (when using official endpoints)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
